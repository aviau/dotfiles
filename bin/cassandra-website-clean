#!/usr/bin/env bash

set -eo pipefail

main() {
    # run.sh names its containers "website_content" and "website_ui" and runs them with
    # --rm, but `preview` runs them as long-lived servers and an interrupted run (Ctrl-C,
    # timeout, or the -p persist option) can leave one running.
    local containers
    containers="$(docker ps -q --filter "name=^website_content$" --filter "name=^website_ui$")"
    [ -z "${containers}" ] || docker stop ${containers}

    # Removes Antora/UI build output. content/ isn't gitignored (it gets committed on the
    # asf-staging/asf-site branches), so this only clears the untracked files generated by
    # run.sh (404.html, doc/, assets/, etc.) and leaves tracked files (.htaccess, robots.txt,
    # sitemap.xml) alone even if locally modified.
    git clean -fdx -- content site-content/build site-ui/build
}

main "$@"
